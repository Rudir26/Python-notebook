    "correctName = \"John\"\n",
    "\n",
    "print(\"Please guess my name.\")\n",
    "\n",
    "while True:\n",
    "    name = input()\n",
    "\n",
    "    if name == correctName:\n",
    "        print(\"Congratulations!\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"Wrong answer.\")\n"
